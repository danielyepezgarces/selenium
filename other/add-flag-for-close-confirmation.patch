+bool UnloadController::CanCloseWithMultipleTabs() {
+  // Flag for tab close confirmation
+  const base::CommandLine& command_line =
+      *base::CommandLine::ForCurrentProcess();
+  const bool close_confirmation = command_line.HasSwitch("close-confirmation");
+  const std::string close_confirmation_value =
+      command_line.GetSwitchValueASCII("close-confirmation");
+  const bool close_window_confirmation =
+      command_line.HasSwitch("close-window-confirmation");
+
+  if (!close_confirmation && !close_window_confirmation) {
+    return true;
+  }
+  if (close_confirmation && (close_confirmation_value != "window" &&
+                             close_confirmation_value != "all")) {
+    return true;
+  }
+
+  if (close_multitab_confirmation_state_ ==
+      CancelDownloadConfirmationState::kResponseReceived) {
+    return true;
+  }
+
+  if (browser_->tab_strip_model()->count() <= 1) {
+    return true;
+  }
+
+  chrome::ShowQuestionMessageBox(
+      browser_->window()->GetNativeWindow(),
+      l10n_util::GetStringUTF16(IDS_PRODUCT_NAME),
+      l10n_util::GetStringUTF16(IDS_CONFIRM_CLOSE_WINDOW),
+      base::BindOnce(&UnloadController::MultitabResponse,
+                     weak_factory_.GetWeakPtr()));
+
+  return false;
+}
