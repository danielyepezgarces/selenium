# Local configuration and operating-system metadata.
.DS_Store
API_KEYS.txt

# Release packages. These cover the Linux, Windows, macOS, and Android
# artifacts published on Thorium release pages.
*.deb
*.rpm
*.snap
*.AppImage
*.dmg
*.zip
*.apk

# Windows build and packaging outputs. Keep this scoped to generated Thorium
# installers rather than ignoring every .exe; the repository intentionally
# tracks a small number of executable build tools.
mini_installer.exe
thorium*installer*.exe
selenium*installer*.exe

# Repository-local packaging output directories.
/release/
/test/
/infra/APPIMAGE/out/*
!/infra/APPIMAGE/out/.gitkeep
Thorium_squashfs-root/

# Interrupted portable-package transactions.
.*.zip.lock
.*.zip.*.new

# Python bytecode and cache directories.
__pycache__/
*.py[cod]
